# External simulation dependencies. Consumed ONLY by Dockerfile.sim (aris-space/project-polaris-docker,
# which keeps a hand-synced copy of this file), which imports them
# into /opt/sim_deps (outside the workspace) — never by setup_submodules.sh, never on the Jetson.
repositories:
  bluerov2_gz:
    type: git
    url: https://github.com/clydemcqueen/bluerov2_gz
    version: main
  ros2_shared:
    type: git
    url: https://github.com/ptrmu/ros2_shared
    version: master
  ardupilot_gazebo:
    type: git
    url: https://github.com/ArduPilot/ardupilot_gazebo
    version: 4b30a3d8
