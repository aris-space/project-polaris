# External I2C baro. On SITL, BARO_EXT_BUS 1 can yield invalid pressure and MAV_STATE_CRITICAL;
# for Gazebo-only sim, comment this line or set BARO_EXT_BUS 0. Re-enable for real Bar30 hardware.
BARO_EXT_BUS 0

# Enable external nav
# From https://ardupilot.org/copter/docs/common-vio-tracking-camera.html
GPS_TYPE 0            # Disable GPS
VISO_TYPE 1           # External vision
EK3_SRC1_POSXY 6      # External nav
EK3_SRC1_VELXY 6      # External nav
EK3_SRC1_POSZ 6       # External nav
EK3_SRC1_VELZ 0       # None
COMPASS_USE 0         # Disable compass 1
COMPASS_USE2 0        # Disable compass 2
COMPASS_USE3 0        # Disable compass 3
EK3_SRC1_YAW 6        # External nav

# Bar30 depth noise (orca_sim_sensors/README.md, "Bar30"). The Bar30 is the Pixhawk's second
# barometer on the vehicle; mavlink_publisher turns its SCALED_PRESSURE2 into
# /pixhawk/scaled_pressure. SITL adds uniform noise of +-SIM_BARx_RND metres of depth per sample
# (AP_Baro_SITL: noise * rand_float(), rand_float in [-1, 1]), so std = RND / sqrt(3).
# Both baros get the same noise so ArduSub's depth hold and ROS see the same sensor class.
# Default std 5 mm (Bar30 resolution is 0.2 mbar = 2 mm; pressure_z_ned_to_pose assumes 2 mm).
#   std 2 mm -> RND 0.0035      std 5 mm -> RND 0.0087      std 1 cm -> RND 0.0173
SIM_BARO_RND 0.0087
SIM_BAR2_RND 0.0087

# Huge negative SCALED_PRESSURE on primary baro = bad SITL altitude in AP_Baro_SITL (JSON/Gazebo
# FDM), not ROS. Fix the plugin/frame (see ArduPilot JSON SITL docs) or try: SIM_BARO_DISABLE 1
# (may affect EKF). mavlink_bridge can publish a hydrostatic estimate from /odom for the monitor.

# SITL second UART: MAVLink on TCP 5762 (SERIAL1) for a companion / second GCS link.
# See https://ardupilot.org/dev/docs/learning-ardupilot-uarts-and-the-console.html
SERIAL1_PROTOCOL 2

# Polaris custom frame: SUB_FRAME_CUSTOM = 7 (mixer in fork's AP_Motors6DOF.cpp:179-187).
FRAME_CONFIG 7

# SITL third UART: MAVLink on TCP 5763 (SERIAL2) for mavlink_bridge's separate GCS-heartbeat
# connection (ros2_receiver._gcs_port, MAVLINK_GCS_URL). SITL serves one client per port.
SERIAL2_PROTOCOL 2

# SITL SERIAL5: MAVLink for a human GCS (MAVProxy / QGroundControl). sim_launch.py points it at
# udpclient:127.0.0.1:14550, the port QGC and MAVProxy listen on by default. SERIAL0-2 are
# all taken by mavlink_bridge (one client per TCP port).
SERIAL5_PROTOCOL 2
