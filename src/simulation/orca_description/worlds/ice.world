<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="ice">

    <!-- Blue-green ambient light and background, so the scene reads as underwater -->
    <scene>
      <ambient>0.3 0.4 0.5 1</ambient>
      <background>0.1 0.3 0.45 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Base Gazebo plugins -->
    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>
    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
<!--      <render_engine>ogre</render_engine>-->
    </plugin>

    <!-- IMU plugin manages all IMU sensors -->
    <plugin
        filename="libgz-sim-imu-system.so"
        name="gz::sim::systems::Imu">
    </plugin>

    <!-- Buoyancy plugin manages buoyancy for all models -->
    <plugin
        filename="gz-sim-buoyancy-system"
        name="gz::sim::systems::Buoyancy">
      <!-- Fluid density is 1 (air) above 0 and 1000 (water) below 0 -->
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <!-- Enable by model name -->
      <enable>orca4</enable>
    </plugin>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <include>
     <uri>model://sand_heightmap</uri>
     <pose>0 7 -10 0 0 0</pose>
    </include>

    <!-- Water surface at z = 0, where the Buoyancy plugin switches water -> air.
         Visual only: no collision, so physics is unaffected. A thin box rather than
         a <plane> so it is visible from above and from below. -->
    <model name="water_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="surface">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>200 200 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0.35 0.55 1</ambient>
            <diffuse>0 0.35 0.55 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
          <transparency>0.8</transparency>
        </visual>
      </link>
    </model>


    <!-- Ice layer: a physical barrier from z = -0.3 to z = 0.1 m over the whole 200 x 200 m
         scene, with a 3 x 3 m hole centred on the origin (the spawn point), where the vehicle
         can reach the surface. Four static boxes around the hole, axis-aligned with no rotation:
         orca_sim_sensors/sim_top_ultrasonic_node ray-casts against these collision boxes, so
         keep that shape when editing. Buoyancy is unaffected: the plugin only acts on orca4. -->
    <model name="ice_layer">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="north_collision">
          <pose>0 50.75 -0.1 0 0 0</pose>
          <geometry><box><size>200 98.5 0.4</size></box></geometry>
        </collision>
        <visual name="north_visual">
          <pose>0 50.75 -0.1 0 0 0</pose>
          <geometry><box><size>200 98.5 0.4</size></box></geometry>
          <material>
            <ambient>0.85 0.92 0.97 1</ambient>
            <diffuse>0.85 0.92 0.97 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
          <transparency>0.3</transparency>
        </visual>
        <collision name="south_collision">
          <pose>0 -50.75 -0.1 0 0 0</pose>
          <geometry><box><size>200 98.5 0.4</size></box></geometry>
        </collision>
        <visual name="south_visual">
          <pose>0 -50.75 -0.1 0 0 0</pose>
          <geometry><box><size>200 98.5 0.4</size></box></geometry>
          <material>
            <ambient>0.85 0.92 0.97 1</ambient>
            <diffuse>0.85 0.92 0.97 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
          <transparency>0.3</transparency>
        </visual>
        <collision name="east_collision">
          <pose>50.75 0 -0.1 0 0 0</pose>
          <geometry><box><size>98.5 3 0.4</size></box></geometry>
        </collision>
        <visual name="east_visual">
          <pose>50.75 0 -0.1 0 0 0</pose>
          <geometry><box><size>98.5 3 0.4</size></box></geometry>
          <material>
            <ambient>0.85 0.92 0.97 1</ambient>
            <diffuse>0.85 0.92 0.97 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
          <transparency>0.3</transparency>
        </visual>
        <collision name="west_collision">
          <pose>-50.75 0 -0.1 0 0 0</pose>
          <geometry><box><size>98.5 3 0.4</size></box></geometry>
        </collision>
        <visual name="west_visual">
          <pose>-50.75 0 -0.1 0 0 0</pose>
          <geometry><box><size>98.5 3 0.4</size></box></geometry>
          <material>
            <ambient>0.85 0.92 0.97 1</ambient>
            <diffuse>0.85 0.92 0.97 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
          <transparency>0.3</transparency>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://orca4</uri>
      <pose>0 0.0 -0.2 0 0 0.0</pose>
    </include>

    <!-- <include>
     <uri>model://axes</uri>
     <pose>0 2 0.2 0 0 0</pose>
    </include> -->

  </world>
</sdf>
