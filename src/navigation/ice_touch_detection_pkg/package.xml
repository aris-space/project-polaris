  <version>0.0.0</version>
  <description>Detects contact between the AUV tower and the ice ceiling using ultrasonic, IMU, and pressure sensors.</description>
  <maintainer email="todo@example.com">root</maintainer>
  <license>TODO: License declaration</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
