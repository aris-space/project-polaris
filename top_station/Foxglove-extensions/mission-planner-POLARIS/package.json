{
  "name": "ros-mission-planner-polaris",
  "displayName": "Mission Planner POLARIS",
  "description": "Map-based mission planner: safe area, start point, path and live vehicle track",
  "publisher": "Polaris",
  "homepage": "https://github.com/BitCurious/project-polaris",
  "repository": {
    "type": "git",
    "url": "https://github.com/BitCurious/project-polaris.git",
    "directory": "top_station/Foxglove-extensions/mission-planner-POLARIS"
  },
  "version": "1.3.0",
  "license": "MIT",
  "main": "./dist/extension.js",
  "keywords": [
    "foxglove-extension",
    "panel",
    "map",
    "mission",
    "planner",
    "ros2"
  ],
  "scripts": {
    "build": "foxglove-extension build",
    "foxglove:prepublish": "foxglove-extension build --mode production",
    "lint:ci": "eslint --report-unused-disable-directives .",
    "lint": "eslint --report-unused-disable-directives --fix .",
    "local-install": "foxglove-extension install",
    "package": "foxglove-extension package",
    "pretest": "foxglove-extension pretest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@foxglove/eslint-plugin": "2.1.2",
    "@foxglove/extension": "2.49.0",
    "@types/leaflet": "1.9.12",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "create-foxglove-extension": "1.3.1",
    "css-loader": "7.1.2",
    "eslint": "9.39.4",
    "prettier": "3.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "style-loader": "4.0.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  }
}
