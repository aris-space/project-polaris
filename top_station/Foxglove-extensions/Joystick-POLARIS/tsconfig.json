{
  "include": ["./src/**/*"],
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": ["dom", "es2020"],
    "skipLibCheck": true,

    "composite": false,
    "declaration": false,

    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true
  }
}
