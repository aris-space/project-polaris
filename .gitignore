# Ignore log files
# Matches any file with .log extension, rotated logs (e.g. file.log.1), and compressed logs
*.log
*.log.*
*.log.gz
# Common logs directory
logs/

# Local editor/runtime artifacts (keep common defaults)
.DS_Store
._*
.AppleDouble
.LSOverride
__pycache__/
*.pyc
venv/
venv*/
env/
.venv/
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
ping-python/

settings.json
.env

# ROS 2 workspace build artifacts
**/build/
**/install/
**/log/
# Compiled objects, libraries and make dependency files
# (e.g. xsens_mti_ros2_driver builds lib/xspublic in-tree)
*.o
*.a
*.so
*.d
*.dpp
/recordings/
/measurements/
# VS Code extension artifact
.vscode/settings.json
mavlink_logs/
CLAUDE.md

